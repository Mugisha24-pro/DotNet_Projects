<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MarketPriceTracker.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Market Price Tracker</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <style>
            .side-link i {
                font-size: 1.15rem;
                width: 1.5rem;
                text-align: center;
            }

            body {
                background: #f1f5fb;
            }

            .layout {
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                display: flex;
                flex-direction: column;
                padding: 24px 16px;
                background: linear-gradient(180deg, #2563eb, #1e40af);
                color: #fff;
                box-shadow: 4px 0 16px rgba(0,0,0,.15);
            }

            .brand {
                font-weight: 700;
                font-size: 1.2rem;
                letter-spacing: .5px;
                padding: 0 8px 16px;
                margin-bottom: 20px;
                border-bottom: 1px solid rgba(255,255,255,.3);
            }

                .brand a {
                    color: #fff;
                    text-decoration: none;
                }

                .brand small {
                    display: block;
                    font-weight: 400;
                    font-size: .75rem;
                    opacity: .75;
                    letter-spacing: 0;
                }

            .side-nav {
                list-style: none;
                margin: 0;
                padding: 0;
            }

                .side-nav li {
                    margin-bottom: 6px;
                }

            .side-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 14px;
                border-radius: 10px;
                color: #e6efff;
                text-decoration: none;
                cursor: pointer;
            }

                .side-link:hover {
                    background: rgba(255,255,255,.14);
                    color: #fff;
                }

                .side-link.active {
                    background: #fff;
                    color: #1d4ed8;
                    font-weight: 600;
                }

            .side-bottom {
                margin-top: auto;
                padding-top: 14px;
                border-top: 1px solid rgba(255,255,255,.3);
            }

            .side-user {
                display: block;
                padding: 6px 14px;
                font-size: .85rem;
                opacity: .9;
            }

            .content-area {
                margin-left: 260px;
                padding: 32px;
                width: calc(100% - 260px);
            }

            @media (max-width: 768px) {
                .layout {
                    flex-direction: column;
                }

                .sidebar {
                    position: static;
                    width: 100%;
                }

                .content-area {
                    margin-left: 0;
                    width: 100%;
                    padding: 16px;
                }
            }
        </style>

        <div class="layout">
            <aside class="sidebar">
                <div class="brand">
                    <a runat="server" href="~/Dashboard.aspx">
                        <i class="bi bi-graph-up-arrow"></i>
                        MARKET PRICE TRACKER
                     </a>
                    <small>RWANDA Food Prices</small>
                </div>

                <ul class="side-nav">
                    <li id="liDashboard" runat="server"><a class="side-link" href="Dashboard.aspx"><i class="bi bi-speedometer2"></i>Dashboard</a></li>
                    <li id="liCompare" runat="server"><a class="side-link" href="Compare.aspx"><i class="bi bi-bar-chart-line"></i>Compare Prices</a></li>
                    <li id="liReports" runat="server"><a class="side-link" href="Reports.aspx"><i class="bi bi-clipboard-data"></i>Price Reports</a></li>
                    <li id="liMarkets" runat="server"><a class="side-link" href="Markets.aspx"><i class="bi bi-shop"></i>Markets</a></li>
                    <li id="liProducts" runat="server"><a class="side-link" href="Products.aspx"><i class="bi bi-basket2"></i>Products</a></li>
                    <li id="liUsers" runat="server"><a class="side-link" href="Users.aspx"><i class="bi bi-people"></i>Users</a></li>
                    <li id="liLogin" runat="server"><a class="side-link" href="Login.aspx"><i class="bi bi-box-arrow-in-right"></i>Login</a></li>
                    <li id="liSignup" runat="server"><a class="side-link" href="Signup.aspx"><i class="bi bi-person-plus"></i>Sign up</a></li>
                </ul>

                <ul class="side-nav side-bottom">
                    <li id="liProfile" runat="server"><a class="side-link" href="Profile.aspx"><i class="bi bi-person-circle"></i>My Profile</a></li>
                    <li id="liUser" runat="server">
                        <asp:Label ID="lblUser" runat="server" CssClass="side-user" />
                    </li>
                    <li id="liLogout" runat="server">
                        <asp:LinkButton ID="lnkLogout" runat="server" CssClass="side-link"
                            OnClick="lnkLogout_Click" CausesValidation="false"><i class="bi bi-box-arrow-right"></i> Logout</asp:LinkButton>
                    </li>
                </ul>
            </aside>

            <main class="content-area">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>

        <script>
// Highlight the link of the current page
document.querySelectorAll('.side-nav a').forEach(function (a) {
    var href = a.getAttribute('href');
    if (!href || href.indexOf('javascript') === 0) return;
    var page = location.pathname.toLowerCase().replace('.aspx', '');
    var target = href.toLowerCase().replace('.aspx', '');
    if (page.endsWith('/' + target)) a.classList.add('active');
});
</script>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
